{
  "name": "h2h-arbitrage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/release-manager.mjs build",
    "build:raw": "node scripts/assert-isolated-build.mjs && next build && npm run build:ragnar && npm run build:scan-worker && npm run build:watcher && npm run build:valuer && npm run build:maintenance && npm run build:recovery",
    "release:promote": "node scripts/release-manager.mjs promote",
    "release:rollback": "node scripts/release-manager.mjs rollback",
    "release:verify": "node scripts/release-manager.mjs verify-active",
    "release:cleanup": "node scripts/release-manager.mjs cleanup",
    "build:scan-worker": "esbuild scripts/full-scan-worker.ts --bundle --platform=node --format=cjs --outfile=dist/full-scan-worker.cjs --external:@libsql/client",
    "build:ragnar": "cp scripts/ragnar-consumer.mjs ${H2H_NEXT_DIST_DIR:-.next}/ragnar-consumer.mjs",
    "build:watcher": "esbuild scripts/ws-watcher.ts --bundle --platform=node --format=esm --outfile=dist/ws-watcher.mjs --external:@libsql/client --external:ws --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:valuer": "esbuild scripts/position-valuer.ts --bundle --platform=node --format=esm --outfile=dist/position-valuer.mjs --external:@libsql/client --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "build:maintenance": "cp scripts/db-maintenance.mjs dist/db-maintenance.mjs",
    "build:recovery": "esbuild scripts/recover-bot-entry-evidence.ts --bundle --platform=node --format=esm --outfile=dist/recover-bot-entry-evidence.mjs --external:@libsql/client --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "recover:bot-entry-evidence": "npm run build:recovery && node dist/recover-bot-entry-evidence.mjs",
    "start": "next start",
    "migrate:poll-leases": "node scripts/migrate-poll-leases.mjs",
    "build:migrate-bot-position-pm-identities": "esbuild scripts/fix-bot-position-pm-identifiers.ts --bundle --platform=node --format=esm --outfile=dist/fix-bot-position-pm-identifiers.mjs --external:@libsql/client",
    "migrate:bot-position-pm-identities": "npm run build:migrate-bot-position-pm-identities --silent && node dist/fix-bot-position-pm-identifiers.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@libsql/client": "^0.17.3",
    "@polymarket/clob-client": "^5.8.1",
    "@sentry/nextjs": "^10.56.0",
    "@types/ws": "^8.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
